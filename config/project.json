  "constraints": { "maximumExperiments": 24, "physicalSourceRequiredForConfirmation": true, "humanApprovalBeforeModification": true, "allowedResistorOhms": [10000, 22000, 33000, 47000, 56000, 68000, 100000], "maximumDividerCurrentMilliamps": 1 }
