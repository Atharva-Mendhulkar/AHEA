{
  "name": "hardware-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic hardware diagnosis with deterministic safety and evidence evaluation.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "express": "^5.1.0",
    "openai": "^5.20.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
